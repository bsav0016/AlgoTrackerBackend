# Copy to .env and fill in real values. Never commit the real .env.
#
# Running locally without Docker (see README "Local development"): set DEBUG=True,
# SECRET_KEY to any string, and SYMBOLS / INTERVALS. Postgres, Firebase and the
# payment/email values can stay blank; the database falls back to SQLite.
# Production (DEBUG=False) requires all of these, including Firebase credentials.

# --- Django core ---
# TODO(go-live): generate a new value for the next deployment; never reuse an earlier key.
SECRET_KEY=
DEBUG=False
ALLOWED_HOSTS=algo-tracker-api.collagecreations.org
DOMAIN=algo-tracker-api.collagecreations.org
# Optional. Browser origins allowed to call the API (comma-separated, with scheme). The mobile app is native and
# does not need this. Leave blank in production unless a web client exists; DEBUG=True allows every origin.
# CORS_ALLOWED_ORIGINS=https://app.example.com

# --- Postgres (used directly by the db service; web/workers derive
#     DATABASE_URL from these in docker-compose.yml, do not set it here) ---
POSTGRES_DB=algotracker
POSTGRES_USER=algotracker
POSTGRES_PASSWORD=

# --- Redis (password-reset codes, price cache, background jobs) ---
# docker-compose.yml sets this for the containers. Only needed for local runs
# outside Docker, and only if it isn't redis://localhost:6379/0.
# REDIS_URL=redis://localhost:6379/0

# --- TwelveData ---
TWELVE_DATA_API_KEY=
# key:multiplier pairs, comma-separated, e.g. AAPL:1,MSFT:1
SYMBOLS=
# key:seconds:monthly_charge triples, comma-separated, e.g. 1min:60:100
INTERVALS=

# --- Firebase push notifications ---
# Path relative to the backend root; the file itself is bind-mounted into
# each container by docker-compose.yml (see volumes:) and must exist there
# before `docker compose up`.
FIREBASE_CREDENTIALS_PATH=algotracker-firebase-credentials.json

# --- Stripe ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Shared secret for the RevenueCat webhook. Set the same value as the "Authorization header value" of
# the webhook in the RevenueCat dashboard. If it is empty the webhook rejects every request.
# TODO(go-live): required before the server is live again.
REVENUECAT_WEBHOOK_AUTH=

# Share links: the public address of this API, the app's URL scheme, and the store pages (optional)
PUBLIC_BASE_URL=
SHARE_APP_SCHEME=algotracker
IOS_APP_STORE_URL=
ANDROID_PLAY_STORE_URL=

# --- Email (password reset OTPs) ---
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# --- Credits / backtest pricing ---
MONTHLY_CREDITS=500
BACKTEST_BASE_COST=3
BACKTEST_ITERATIONS=5

# --- Promo codes ---
# key:value pairs, comma-separated
PROMO_CODES=
PROMO_CODE_AVAILABILITY=False
